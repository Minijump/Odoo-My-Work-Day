<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 19 groups a module's access levels under a "privilege" rather than
        the old category, which is what makes them show up as a single dropdown
        on the user form.

        Three levels, each implying the one below:

          Reader         sees their own dashboard, changes nothing
          Editor         builds and edits their own tiles
          Administrator  decides which models are selectable, and may reach
                         every user's dashboard

        Every internal user is a Reader, because a dashboard nobody can open is
        pointless. Editor is granted deliberately: on a database where the
        dashboards are laid out centrally, an administrator builds them and
        everyone else simply reads.
    -->
    <record id="res_groups_privilege_my_work_day" model="res.groups.privilege">
        <field name="name">My Work Day</field>
        <field name="sequence">80</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_my_work_day_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="privilege_id" ref="res_groups_privilege_my_work_day"/>
        <field name="comment">Sees their own dashboard but cannot change it.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_my_work_day_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="privilege_id" ref="res_groups_privilege_my_work_day"/>
        <field name="comment">Builds and edits the tiles on their own dashboard.</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_my_work_day_reader'))]"/>
    </record>

    <record id="group_my_work_day_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_my_work_day"/>
        <field name="comment">Decides which models users may build dashboard tiles on.</field>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_my_work_day_editor')), (4, ref('base.group_user'))]"/>
    </record>

    <!-- Reading your own dashboard is part of being an internal user. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('my_work_day.group_my_work_day_reader'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('my_work_day.group_my_work_day_manager'))]"/>
    </record>

</odoo>
