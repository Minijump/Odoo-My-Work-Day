<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            A dashboard belongs to one person. Rules carrying a group are OR-ed
            together, so an administrator (who is in every group) ends up seeing
            everything, while an ordinary user sees only their own records.

            Read rules sit on Reader and write rules on Editor, so the level that
            decides what a user may change is the group, not the rule. A Reader
            who is handed a dashboard can open it and nothing more.
        -->

        <record id="mwd_dashboard_rule_own" model="ir.rule">
            <field name="name">My Work Day: own dashboards</field>
            <field name="model_id" ref="model_mwd_dashboard"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_reader'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <record id="mwd_dashboard_rule_admin" model="ir.rule">
            <field name="name">My Work Day: all dashboards (administrator)</field>
            <field name="model_id" ref="model_mwd_dashboard"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Tiles: readable if yours or shared, editable only if yours. -->

        <record id="mwd_tile_rule_read" model="ir.rule">
            <field name="name">My Work Day: readable tiles</field>
            <field name="model_id" ref="model_mwd_tile"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_reader'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('is_shared', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="mwd_tile_rule_write" model="ir.rule">
            <field name="name">My Work Day: own tiles</field>
            <field name="model_id" ref="model_mwd_tile"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_editor'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="mwd_tile_rule_admin" model="ir.rule">
            <field name="name">My Work Day: all tiles (administrator)</field>
            <field name="model_id" ref="model_mwd_tile"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Lines follow their tile. -->

        <record id="mwd_tile_line_rule_read" model="ir.rule">
            <field name="name">My Work Day: readable tile lines</field>
            <field name="model_id" ref="model_mwd_tile_line"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_reader'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('tile_id.is_shared', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="mwd_tile_line_rule_write" model="ir.rule">
            <field name="name">My Work Day: own tile lines</field>
            <field name="model_id" ref="model_mwd_tile_line"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_editor'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="mwd_tile_line_rule_admin" model="ir.rule">
            <field name="name">My Work Day: all tile lines (administrator)</field>
            <field name="model_id" ref="model_mwd_tile_line"/>
            <field name="groups" eval="[(4, ref('my_work_day.group_my_work_day_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
