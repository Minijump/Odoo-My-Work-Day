<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="my_work_day.AppsDialog">
        <Dialog title="'Pick your apps'" size="'md'">
            <p class="text-muted">
                These appear as shortcuts at the top of your dashboard.
            </p>

            <div t-if="!apps.length" class="text-muted text-center py-4">
                You have no apps available.
            </div>

            <div t-else="" class="mwd_app_picker">
                <button t-foreach="apps" t-as="app" t-key="app.id"
                        type="button"
                        class="mwd_app_choice"
                        t-att-class="{ 'mwd_app_chosen': isSelected(app) }"
                        t-att-aria-pressed="isSelected(app) ? 'true' : 'false'"
                        t-on-click="() => this.toggle(app)">
                    <span class="mwd_app_check">
                        <i t-if="isSelected(app)" class="fa fa-check"/>
                    </span>
                    <img t-if="app.webIconData" class="mwd_app_choice_icon"
                         t-att-src="app.webIconData" t-att-alt="app.name"/>
                    <i t-else="" class="fa fa-th-large fa-2x text-muted"/>
                    <span class="mwd_app_choice_name" t-esc="app.name"/>
                </button>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onConfirm"
                        t-att-disabled="state.saving">
                    Save
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
                <span class="text-muted ms-auto align-self-center small"
                      t-esc="selectionLabel"/>
            </t>
        </Dialog>
    </t>

</templates>
