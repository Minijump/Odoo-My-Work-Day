<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The dashboard itself. Being a client action means it can be set as a
        user's Home Action, which is the standard way Odoo lets you replace the
        landing page without patching the web client.
    -->
    <record id="action_my_work_day_dashboard" model="ir.actions.client">
        <field name="name">My Work Day</field>
        <field name="tag">my_work_day_dashboard</field>
        <!-- Gives the dashboard a readable URL, /odoo/my-work-day, instead of
             /odoo/action-<database id>. -->
        <field name="path">my-work-day</field>
    </record>

    <record id="action_mwd_dashboard_config" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">mwd.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up a dashboard</p>
            <p>A dashboard holds the tiles that tell you what is waiting for you today.</p>
        </field>
    </record>

    <record id="action_mwd_tile_shared" model="ir.actions.act_window">
        <field name="name">Shared Tiles</field>
        <field name="res_model">mwd.tile</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_shared', '=', True)]</field>
        <field name="context">{'search_default_shared_by_others': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shared tiles yet</p>
            <p>When a colleague shares a tile, it shows up here and you can copy it
               onto your own dashboard. You get their filters, not their data.</p>
        </field>
    </record>

    <!--
        Runs the health check and returns either a notification or a list of
        the tiles that would fail. The method decides which, so there is no
        second action to keep in step.
    -->
    <record id="action_mwd_tile_check" model="ir.actions.server">
        <field name="name">Check Tiles</field>
        <field name="model_id" ref="my_work_day.model_mwd_tile"/>
        <field name="state">code</field>
        <field name="code">action = model.action_check_tiles()</field>
    </record>

    <record id="action_mwd_allowed_model" model="ir.actions.act_window">
        <field name="name">Selectable Models</field>
        <field name="res_model">mwd.allowed.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Choose what users can build on</p>
            <p>Only the models listed here can be used in a dashboard tile. This keeps
               users out of corners of the database nobody meant them to browse.</p>
        </field>
    </record>

</odoo>
